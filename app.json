{
  "expo": {
    "name": "Collectiverse",
    "slug": "collectiverse-v1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "collectiversev1",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#12091f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sam1313.collectiversev1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.sam1313.collectiversev1"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#12091f",
          "dark": {
            "backgroundColor": "#12091f"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Collectiverse uses your photos so you can add collectibles to a deck.",
          "cameraPermission": "Collectiverse uses the camera to photograph collectibles you want to mint.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9514fc51-4872-45ee-96fa-03e039ba6e0c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9514fc51-4872-45ee-96fa-03e039ba6e0c"
    }
  }
}
